{
  "schema": "prompt-order-taxonomy-v2",
  "categories": [
    {
      "name": "品質・ネガティブ",
      "order": 1,
      "purpose": "品質指定、解像度、精細度、スコア。ネガティブ指定は同カテゴリ内で扱い、出力先は独立させる。",
      "subcategories": [
        "ネガティブ・除外指定",
        "高品質・傑作",
        "解像度・精細度",
        "スコア",
        "低品質・ノイズ"
      ]
    },
    {
      "name": "人数・人物構成",
      "order": 2,
      "purpose": "人数、単独・複数人、人物の構成。",
      "subcategories": [
        "人数・人物構成"
      ]
    },
    {
      "name": "キャラクター・作品",
      "order": 3,
      "purpose": "作品・シリーズ名、キャラクター名、作者・配信者などの固有名詞。",
      "subcategories": [
        "作品・シリーズ",
        "キャラクター",
        "作者・配信者"
      ]
    },
    {
      "name": "人物の特徴",
      "order": 4,
      "purpose": "性別、年齢層、体型、肌、身体的特徴など人物全体の属性。顔・髪・身体部位は専用分類へ分ける。",
      "subcategories": [
        "体型・身体的特徴",
        "人物属性",
        "身体部位・身体状態"
      ]
    },
    {
      "name": "顔・表情",
      "order": 5,
      "purpose": "顔立ち、表情、目、視線など顔周辺の特徴。",
      "subcategories": [
        "顔・表情",
        "目",
        "顔の特徴"
      ]
    },
    {
      "name": "髪・頭部",
      "order": 6,
      "purpose": "髪型、髪の状態、耳、角、頭部の装飾など。",
      "subcategories": [
        "髪・頭部",
        "頭部の特徴"
      ]
    },
    {
      "name": "服装・装飾",
      "order": 7,
      "purpose": "衣服、下着、水着、靴、アクセサリー、装備。",
      "subcategories": [
        "衣服",
        "下着",
        "水着",
        "衣服の状態",
        "肌の露出",
